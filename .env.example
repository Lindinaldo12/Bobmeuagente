# Token do seu Bot no Telegram (Obtenha com o @BotFather)
TELEGRAM_BOT_TOKEN=cole_seu_token_aqui

# IDs de acesso (Obtenha seu ID com bots como @userinfobot)
MASTER_ID=seu_id_master_aqui
ADMIN_IDS=["id_admin_1", "id_admin_2"]

# Senha para comandos administrativos
ACCESS_PASSWORD=sua_senha_segura_aqui

# Configuração da IA Local (Ollama)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# (FUTURO) Configuração para Nuvem (Render/VPS)
# Quando migrar, você trocará o modelo local por uma API Key (ex: OpenRouter ou Groq)
# API_KEY=sua_chave_de_api_aqui
# MODEL_NAME=qwen/qwen2.5-coder-32b
