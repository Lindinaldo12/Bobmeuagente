# Configuração do Bob AI X (Hermes Agent)
# Copie este arquivo para .env e preencha os valores

# ─── API da IA ──────────────────────────────────────────────────────────────
# URL base da API (OpenRouter)
AI_BASE_URL=https://openrouter.ai/api/v1
# Chave da API do OpenRouter
AI_API_KEY=SEU_OPENROUTER_API_KEY_AQUI
# Modelo da IA
AI_MODEL=qwen/qwen-2.5-7b-instruct

# ─── Telegram (o bot) ────────────────────────────────────────────────────────
# Token do bot (obtido no @BotFather do Telegram)
TELEGRAM_TOKEN=SEU_TELEGRAM_BOT_TOKEN_AQUI
# ID do usuário (master)
MASTER_ID=SEU_ID_TELEGRAM_AQUI
# IDs dos administradores
ADMIN_IDS='["SEU_ID_ADMIN"]'
# Senha de acesso ao bot
ACCESS_PASSWORD=SUA_SENHA_AQUI

# ─── Outros ──────────────────────────────────────────────────────────────────
# ID do chat do criador (já configurado no render.yaml)
CRIADOR_CHAT_ID=8133082447
# Histórico de mensagens máximo
MAX_HISTORICO=100
# Tamanho máximo de arquivos
MAX_CHARS_ARQUIVO=10000
