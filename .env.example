# === API KEYS E CONFIGURAÇÕES DA IA ===
# Provedor 1 — Google Gemini (padrão)
# Obtenha em: https://aistudio.google.com/app/apikey
# (requer: pip install google-genai)
GOOGLE_API_KEY=

# Provedor 2 — OpenRouter (fallback; acesso a vários modelos via UMA API key)
# Obtenha em: https://openrouter.ai/keys
# (requer: pip install openai)
# Ex.: MODEL_NAME=openai/gpt-4o-mini
OPENROUTER_API_KEY=

# === MODELO DE IA (usado quando o fallback aciona os dois provedores) ===
# Dica: comece com openai/gpt-4o-mini (barato e confiável) ou
# google/gemini-2.5-flash (igual ao Gemini, via OpenRouter)
MODEL_NAME=

# === TELEGRAM BOT ===
# Token do Bot (obtenha em @BotFather no Telegram)
TELEGRAM_BOT_TOKEN=

# === CONFIGURAÇÕES DO BOT ===
# ID do dono do bot (usado para verificação de acesso)
BOT_OWNER_ID=

# === PLAYWRIGHT (browser headless) ===
# Instale com: python -m playwright install chromium

# === RENDER (configuração do deploy) ===
# As seguintes variáveis DEVEM ser setadas no dashboard do Render
# (Settings -> Environment) e NÃO no repositório. O render.yaml já as
# referencia automaticamente.
# - OPENROUTER_API_KEY  (chave do https://openrouter.ai/keys)
# - MODEL_NAME          (ex.: openai/gpt-4o-mini)
# - TELEGRAM_BOT_TOKEN  (tema do @BotFather)
# - GOOGLE_API_KEY      (opcional; só usa se o Gemini for mantido ativo)

