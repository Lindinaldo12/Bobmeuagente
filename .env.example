# === API KEYS E CONFIGURAÇÕES DA IA ===

# OpenRouter API Key (para a IA)
# Obtenha em: https://openrouter.ai/keys
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=sk-or-v1-
AI_MODEL=deepseek/deepseek-chat-v3-0324

# === TELEGRAM BOT ===

# Token do Bot (obtenha em @BotFather no Telegram)
TELEGRAM_TOKEN=

# ID do usuário principal (Master)
# Obtenha seu ID com @userinfobot no Telegram
MASTER_ID=

# IDs dos administradores (separados por vírgula)
ADMIN_IDS=

# IDs de usuários permitidos (separados por vírgula)
# Opcional: se vazio, todos os usuários são permitidos
TELEGRAM_ALLOWED_USERS=

# === CONFIGURAÇÕES DE SEGURANÇA ===

# Senha de acesso (opcional)
ACCESS_PASSWORD=

# ID do chat do criador
CRIADOR_CHAT_ID=

# === CONFIGURAÇÕES DO AGENTE ===

# Tamanho máximo do histórico de conversa
MAX_HISTORICO=50

# Tamanho máximo de caracteres em arquivo
MAX_CHARS_ARQUIVO=10000

# === CONFIGURAÇÕES DO RENDER ===

# Porta do Render
PORT=10000

# Ambiente de execução
PYTHONUNBUFFERED=1
